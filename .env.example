# ---------------------------------------------------------------------------
# Calma: environment template. Copy to .env and fill in. NEVER commit real keys.
# The backend (Laravel) has its own .env inside backend/ with the same values.
# ---------------------------------------------------------------------------

# --- Backend (Laravel) ---
APP_NAME=Calma
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

# PostgreSQL on Supabase: Project Settings > Database > Connection string > "Session pooler".
# Ask the team lead for the real values. NEVER put them in the repo or in a screenshot.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# First admin account created by `php artisan migrate --seed`
ADMIN_EMAIL=admin@calma.test
ADMIN_PASSWORD=change-me

# Email (forgot-password codes). `log` writes the email to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@calma.test
MAIL_FROM_NAME="${APP_NAME}"

# --- AI services (Python) ---
# Base URL of ai-services (empty = the backend answers with a stub)
CHATBOT_URL=
CHATBOT_API_KEY=
CHATBOT_TIMEOUT=20
CHATBOT_VOICE_TIMEOUT=60
CHATBOT_HISTORY_LIMIT=10
OPENAI_API_KEY=

# --- Articles pipeline (php artisan articles:fetch, daily) ---
# RSS / Atom addresses separated by commas. Empty = nothing is imported.
ARTICLE_FEEDS=

# --- Files: Supabase Storage (only on the server; on a laptop keep both as local) ---
PRIVATE_STORAGE=local
PUBLIC_STORAGE=local
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_PRIVATE_BUCKET=calma-private
SUPABASE_PUBLIC_BUCKET=calma-public
SUPABASE_PUBLIC_URL=

# --- E-mail for "forgot password" over HTTPS (Brevo). Empty = the normal MAIL_MAILER is used ---
BREVO_API_KEY=

# --- Secret that lets a free scheduler start the daily article import ---
ARTICLE_CRON_TOKEN=
